---
import Divider from '@/components/Divider.astro';
interface Props {
  kicker?: string;
  title?: string;
  subtitle?: string;
  divider?: 'leaf' | 'river' | 'line' | 'none';
}
---

<section class="reveal max-w-4xl mx-auto text-center mb-24 lg:mb-32">
  {Astro.props.kicker && (
    <div class="kicker">
      <span>{Astro.props.kicker}</span>
      <span class="kicker-line"></span>
    </div>
  )}
  {Astro.props.title && (
    <h2 class="mb-6 md:mb-8 tracking-tight">{Astro.props.title}</h2>
  )}
  {Astro.props.subtitle && (
    <p class="text-lg md:text-xl text-forest/80 max-w-2xl mx-auto leading-relaxed">
      {Astro.props.subtitle}
    </p>
  )}
  {Astro.props.divider && Astro.props.divider !== 'none' && (
    <Divider style={Astro.props.divider} class="mt-12 lg:mt-16" />
  )}
</section>
