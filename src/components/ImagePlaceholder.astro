---
interface Props {
  src?: string;
  alt: string;
  caption?: string;
  ratio?: '16-9' | '4-3' | '1-1' | '3-2' | '2-3' | '9-16';
  class?: string;
  lazy?: boolean;
}

const { src, alt, caption, ratio = '16-9', class: className = '', lazy = true } = Astro.props;

const ratioClasses = {
  '16-9': 'aspect-[16/9]',
  '4-3': 'aspect-[4/3]',
  '1-1': 'aspect-square',
  '3-2': 'aspect-[3/2]',
  '2-3': 'aspect-[2/3]',
  '9-16': 'aspect-[9/16]',
};

const hasImage = Boolean(src);
---

<figure class="relative overflow-hidden rounded-organic border border-forest/20 bg-forest/5 {className}">
  {hasImage ? (
    <img
      src={src}
      alt={alt}
      class={`w-full h-full object-cover ${lazy ? 'loading=lazy' : ''} ${ratioClasses[ratio]}`}
      decoding="async"
    />
  ) : (
    <div class={`w-full h-full ${ratioClasses[ratio]} flex flex-col items-center justify-center gap-3`}>
      <div class="w-20 h-20 rounded-full bg-forest/10 border border-forest/20 flex items-center justify-center">
        <svg class="w-10 h-10 text-forest/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 002 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <p class="text-forest/40 text-sm font-body italic">
        Fotografía real pendiente
      </p>
      {caption && <span class="text-forest/30 text-xs uppercase tracking-widest">{caption}</span>}
    </div>
  )}
  {hasImage && caption && (
    <figcaption class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-forest/90 to-transparent text-ivory text-sm font-body">
      {caption}
    </figcaption>
  )}
</figure>

<style>
  figure {
    margin: 0;
  }
</style>
