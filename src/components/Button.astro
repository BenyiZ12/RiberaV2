---
interface Props {
  variant?: 'primary' | 'outline' | 'ghost';
  as?: 'a' | 'button';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
}

const { variant = 'primary', as = 'a', href, type = 'button', children } = Astro.props;

const classes = {
  primary: 'btn-primary',
  outline: 'btn-outline',
  ghost: 'btn-ghost',
}[variant];

const Tag = as === 'button' ? 'button' : 'a';
</template>

<Tag
  class={classes}
  href={href}
  type={type}
  {...Astro.attributes}
>
  <span>{children}</span>
  {variant === 'primary' && (
    <svg class="w-4 h-4 ml-1 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
  )}
</Tag>

</template>