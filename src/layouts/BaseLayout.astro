---
import { SITE, SEO_DEFAULTS, CONTACT } from '@/config/site';
import ScrollProgress from '@/components/ScrollProgress.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  structuredData?: Record<string, unknown>;
  noIndex?: boolean;
}

const {
  title = SITE.name,
  description = SITE.description,
  canonical,
  ogType = SEO_DEFAULTS.ogType,
  ogImage = SEO_DEFAULTS.defaultImage,
  structuredData,
  noIndex = false,
} = Astro.props;

const absoluteUrl = (path: string) => new URL(path, SITE.url).href;

const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const pageDescription = description || SITE.description;
const pageCanonical = canonical ? absoluteUrl(canonical) : absoluteUrl(Astro.url.pathname);
const pageOgImage = absoluteUrl(ogImage);

const isIndexable = !noIndex;
</template>

<!DOCTYPE html>
<html lang="es-CR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#173D30" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="language" content="es-CR" />
    <meta name="robots" content={isIndexable ? 'index, follow' : 'noindex, nofollow'} />

    <link rel="canonical" href={pageCanonical} />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:image" content={pageOgImage} />
    <meta property="og:locale" content={SEO_DEFAULTS.locale} />
    <meta property="og:site_name" content={SITE.name} />

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageOgImage} />

    {/* Preconnect a fuentes de Google */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Manrope:wght@400;500;600;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Manrope:wght@400;500;600;800&display=swap"
      />
    </noscript>

    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}
  </head>
  <body class="antialiased">
    <a href="#main" class="visually-hidden focus:not-visually-hidden focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-forest focus:text-ivory focus:rounded focus:font-body focus:text-sm">
      Saltar al contenido principal
    </a>

    <ScrollProgress />
    <Header />
    <main id="main" tabIndex={-1}>
      <slot />
    </main>
    <Footer />

    <script src="/scripts/scroll-reveal.js"></script>
    <script src="/scripts/parallax.js"></script>
    <script src="/scripts/mobile-menu.js"></script>
    <script src="/scripts/lightbox.js"></script>
  </body>
</html>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .focus:not-visually-hidden {
    position: static;
    width: auto;
    height: auto;
    padding: inherit;
    margin: inherit;
    overflow: visible;
    clip: auto;
    white-space: normal;
    border: inherit;
  }
</style>

</template>