---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/SectionHead.astro';
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';
---

<BaseLayout
  title="Galería"
  description="Galería de fotografías de Centro Ecológico La Ribera: cabañas, piscinas, zonas verdes y entorno natural en Pérez Zeledón, Costa Rica."
  canonical="/galeria"
>
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Galería"
        title="Momentos en La Ribera"
        subtitle="Fotografías reales de las instalaciones, cabañas, piscinas y el entorno natural de Centro Ecológico La Ribera."
        divider="leaf"
      />

      <div class="grid md:grid-cols-4 gap-4 mt-16" data-stagger="60">
        <a href="" data-lightbox data-caption="Fotografía 1 de Centro Ecológico La Ribera" class="block rounded-organic overflow-hidden border border-forest/20 bg-forest/5 group">
          <div class="aspect-[4/3] md:aspect-[3/2] lg:aspect-square flex items-center justify-center group-hover:scale-105 transition-transform duration-500">
            <ImagePlaceholder src="" alt="Cabaña La Ribera" ratio="1-1" />
          </div>
        </a>
        <a href="" data-lightbox data-caption="Fotografía 2 de Centro Ecológico La Ribera" class="block rounded-organic overflow-hidden border border-forest/20 bg-forest/5 group">
          <div class="aspect-[4/3] md:aspect-[3/2] lg:aspect-square flex items-center justify-center group-hover:scale-105 transition-transform duration-500">
            <ImagePlaceholder src="" alt="Piscina La Ribera" ratio="1-1" />
          </div>
        </a>
        <a href="" data-lightbox data-caption="Fotografía 3 de Centro Ecológico La Ribera" class="block rounded-organic overflow-hidden border border-forest/20 bg-forest/5 group">
          <div class="aspect-[4/3] md:aspect-[3/2] lg:aspect-square flex items-center justify-center group-hover:scale-105 transition-transform duration-500">
            <ImagePlaceholder src="" alt="Zonas verdes La Ribera" ratio="1-1" />
          </div>
        </a>
        <a href="" data-lightbox data-caption="Fotografía 4 de Centro Ecológico La Ribera" class="block rounded-organic overflow-hidden border border-forest/20 bg-forest/5 group">
          <div class="aspect-[4/3] md:aspect-[3/2] lg:aspect-square flex items-center justify-center group-hover:scale-105 transition-transform duration-500">
