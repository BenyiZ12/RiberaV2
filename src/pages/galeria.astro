          </div>
        </a>
        <a href="" data-lightbox data-caption="Fotografía 5 de Centro Ecológico La Ribera" class="block rounded-organic overflow-hidden border border-forest/20 bg-forest/5 group">
          <div class="aspect-[4/3] md:aspect-[3/2] lg:aspect-square flex items-center justify-center group-hover:scale-105 transition-transform duration-500">
