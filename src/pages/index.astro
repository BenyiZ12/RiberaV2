---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SectionHead from '@/components/SectionHead.astro';
import Divider from '@/components/Divider.astro';
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';
import CTASection from '@/components/CTASection.astro';
import { SITE } from '@/config/site';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  '@id': 'https://www.laribera.cr#organization',
  name: SITE.name,
  image: '/og-image.svg',
  url: 'https://www.laribera.cr',
  telephone: null,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Mollejones de Platanares',
    addressLocality: 'Pérez Zeledón',
    addressCountry: 'Costa Rica',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: null,
    longitude: null,
  },
  description: SITE.description,
  priceRange: null,
};
---

<BaseLayout
  title="Inicio"
  description={SITE.description}
  canonical="/"
  ogImage="/og-image.svg"
  structuredData={structuredData}
>
  <Hero />

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Sobre La Ribera"
        title="Un centro ecológico en el corazón de Pérez Zeledón"
        subtitle="Hospedaje rural, cabañas rodeadas de vegetación, piscinas naturales y senderos para descubrir el entorno del sur de Costa Rica."
        divider="leaf"
      />
      <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center mt-16">
        <div class="reveal">
          <p class="text-lg md:text-xl text-forest/90 leading-relaxed mb-8">
            En Mollejones de Platanares, Pérez Zeledón, encontrarás un espacio pensado para el descanso, la tranquilidad y el encuentro con la naturaleza. Cada rincón de La Ribera está diseñado para que familias, parejas y grupos de amigos se reconecten con lo esencial.
          </p>
          <ul class="space-y-6 font-body">
            <li class="flex items-start gap-3">
              <span class="text-earth mt-0.5">🌿</span>
              <span class="text-forest/90">Cabañas y hospedaje rural</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-earth mt-0.5">🏊</span>
              <span class="text-forest/90">Piscinas y zonas verdes</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-earth mt-0.5">🥾</span>
              <span class="text-forest/90">Senderos y entorno natural</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-earth mt-0.5">🍽️</span>
              <span class="text-forest/90">Restaurante y espacios para compartir</span>
            </li>
          </ul>
        </div>
        <div class="reveal-image">
          <ImagePlaceholder src="" alt="Instalaciones de La Ribera" ratio="4-3" />
        </div>
      </div>
    </div>
  </section>

  <Divider style="river" class="my-24 lg:my-32" />

  <section class="section bg-warm/30">
    <div class="container">
      <SectionHead
        kicker="Entorno natural"
        title="Rodeados de vegetación y silencio"
        subtitle="Zonas verdes, árboles y el sonido del río acompañan tu estadía en La Ribera."
        divider="river"
      />
      <div class="grid md:grid-cols-3 gap-8 mt-16">
        <div class="reveal glass p-8 rounded-organic hover:bg-white/80 transition-colors duration-300">
          <h3 class="text-2xl md:text-3xl font-display mb-3">Zonas verdes</h3>
          <p class="text-forest/80 font-body">Espacios abiertos para descansar y compartir al aire libre.</p>
        </div>
        <div class="reveal glass p-8 rounded-organic hover:bg-white/80 transition-colors duration-300">
          <h3 class="text-2xl md:text-3xl font-display mb-3">Árboles nativos</h3>
          <p class="text-forest/80 font-body">Vegetación del sur de Costa Rica que brinda sombra y frescura.</p>
        </div>
        <div class="reveal glass p-8 rounded-organic hover:bg-white/80 transition-colors duration-300">
          <h3 class="text-2xl md:text-3xl font-display mb-3">Senderos</h3>
          <p class="text-forest/80 font-body">Caminos para caminar y observar la flora y fauna local.</p>
        </div>
      </div>
    </div>
  </section>

  <Divider style="leaf" class="my-24 lg:my-32" />

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Experiencias"
        title="Vive La Ribera"
        subtitle="Desde el descanso en cabaña hasta los recorridos por la naturaleza, cada momento está pensado para disfrutar sin prisa."
        divider="leaf"
      />
      <CTASection
        title="Consultar disponibilidad"
        subtitle="Escríbenos por WhatsApp o contáctanos directamente para planificar tu visita."
        primaryLabel="Consultar disponibilidad"
        primaryHref="/ubicacion"
        secondaryLabel="Ver hospedaje"
        secondaryHref="/hospedaje"
        align="center"
      />
    </div>
  </section>
</BaseLayout>

