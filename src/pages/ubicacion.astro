---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/SectionHead.astro';
import Button from '@/components/Button.astro';
import CTASection from '@/components/CTASection.astro';
import Divider from '@/components/Divider.astro';
import { SITE } from '@/config/site';
---

<BaseLayout
  title="Ubicación y contacto"
  description="Cómo llegar a Centro Ecológico La Ribera en Mollejones de Platanares, Pérez Zeledón, Costa Rica. Información de contacto y WhatsApp."
  canonical="/ubicacion"
>
  <section class="section relative overflow-hidden">
    <div class="container relative z-10">
      <SectionHead
        kicker="Ubicación"
        title="Cómo llegar a La Ribera"
        subtitle="Mollejones de Platanares, Pérez Zeledón, Costa Rica."
        divider="river"
      />

      <div class="grid md:grid-cols-12 gap-12 mt-20">
        <div class="md:col-span-5 lg:col-span-6 reveal">
          <div class="glass p-8 md:p-12 rounded-organic border border-white/70">
            <h3 class="text-3xl md:text-4xl font-display mb-6 tracking-tight">Información de contacto</h3>
            <ul class="space-y-8 font-body">
              <li class="flex items-start gap-4">
                <span class="text-earth mt-0.5 shrink-0">📍</span>
                <div>
                  <p class="text-forest/90 font-semibold">Dirección</p>
                  <p class="text-forest/70 text-sm">{SITE.location}</p>
                </div>
              </li>
              <li class="text-forest/60 italic text-sm">Datos de contacto pendientes de confirmación por el propietario.</li>
            </ul>
          </div>
        </div>

        <div class="md:col-span-7 lg:col-span-6 reveal-image">
          <div class="aspect-[4/3] rounded-organic overflow-hidden border border-forest/20 bg-forest/5 shadow-lg flex items-center justify-center">
            <div class="text-center p-8">
              <svg class="w-16 h-16 text-forest/30 mb-4 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <p class="text-forest/60 font-body text-sm">Mapa por configurar con coordenadas oficiales del propietario.</p>
            </div>
          </div>
        </div>
      </div>

      <Divider style="leaf" class="my-24 lg:my-32" />

      <CTASection
        title="Consultar disponibilidad"
        subtitle="Escríbenos por WhatsApp o contáctanos directamente para planificar tu visita a La Ribera."
        primaryLabel="Escribir por WhatsApp"
        primaryHref="#"
        secondaryLabel="Ver hospedaje"
        secondaryHref="/hospedaje"
        align="center"
      />
    </div>
  </section>
</BaseLayout>

