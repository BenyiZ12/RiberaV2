---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/SectionHead.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/config/site';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe. Regresa al inicio de Centro Ecológico La Ribera."
  canonical="/404"
  noIndex
>
  <section class="section flex flex-col items-center justify-center text-center min-h-[60vh]">
    <SectionHead
      kicker="404"
      title="Página no encontrada"
      subtitle="La ruta que buscas no existe, pero La Ribera te sigue esperando."
      divider="none"
    />

    <div class="max-w-lg mt-16">
      <p class="text-lg md:text-xl text-forest/80 leading-relaxed mb-12">
        No se pudo encontrar la página solicitada. Puede que la dirección haya cambiado o haya un error en el enlace.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button variant="primary" as="a" href="/" label="Regresar al inicio" />
        <Button variant="outline" as="a" href="/ubicacion" label="Contactar con La Ribera" />
      </div>
    </div>
  </section>
</BaseLayout>

